# Generate independent secrets with: openssl rand -base64 48
ADMIN_AUTH_SECRET=
ADMIN_ALTCHA_SECRET=

# Only the immediate reverse proxy may supply forwarded headers.
ADMIN_TRUSTED_PROXIES=127.0.0.1,::1

# Maximum lifetime of an authenticated Web Admin session, in seconds.
ADMIN_SESSION_TTL_SECONDS=28800
# Maximum inactivity time before a Web Admin session expires, in seconds.
ADMIN_SESSION_IDLE_SECONDS=1800

# ALTCHA Proof-of-Work v2, deterministic PBKDF2/SHA-256.
ADMIN_ALTCHA_TTL_SECONDS=120
ADMIN_ALTCHA_COST=5000
ADMIN_ALTCHA_COUNTER_MIN=5000
ADMIN_ALTCHA_COUNTER_MAX=10000

ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_IP_LIMIT=20
ADMIN_LOGIN_ACCOUNT_LIMIT=15
ADMIN_CHALLENGE_WINDOW_SECONDS=60
ADMIN_CHALLENGE_IP_LIMIT=10
ADMIN_CHALLENGE_ACCOUNT_LIMIT=10
